---
/** بطاقة دفع ثلاثية الأبعاد أصلية باسم PayCards (SVG + CSS) — ليست صورة بطاقة RedotPay */
---
<div class="card3d-host relative mx-auto w-full max-w-[400px] [perspective:1100px]" aria-hidden="true">
  <div class="card3d-glow absolute inset-6 rounded-[28px] bg-accent/40 blur-3xl"></div>
  <div class="card3d-float">
    <div data-tilt class="card3d relative aspect-[1.586] w-full rounded-[22px] p-[6%] text-white">
      <div class="card3d-shine absolute inset-0 rounded-[22px]"></div>
      <svg class="absolute inset-0 h-full w-full rounded-[22px]" viewBox="0 0 400 252" preserveAspectRatio="none">
        <defs>
          <linearGradient id="c3-bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0f2a3f" />
            <stop offset=".55" stop-color="#0b1a33" />
            <stop offset="1" stop-color="#1a1447" />
          </linearGradient>
          <radialGradient id="c3-orb" cx=".85" cy=".1" r=".7">
            <stop offset="0" stop-color="#2ee6a8" stop-opacity=".55" />
            <stop offset="1" stop-color="#2ee6a8" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="400" height="252" rx="22" fill="url(#c3-bg)" />
        <rect width="400" height="252" rx="22" fill="url(#c3-orb)" />
        <g fill="none" stroke="#ffffff" stroke-opacity=".07" stroke-width="1.2">
          <circle cx="330" cy="210" r="90" /><circle cx="330" cy="210" r="130" /><circle cx="330" cy="210" r="170" />
        </g>
      </svg>
      <div class="relative flex h-full flex-col justify-between" dir="ltr">
        <div class="flex items-start justify-between">
          <span class="text-[clamp(15px,4.4vw,20px)] font-bold tracking-tight">Pay<span class="text-[#2ee6a8]">Cards</span></span>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-opacity=".85" stroke-width="1.8" stroke-linecap="round"><path d="M8.5 16.5a6.5 6.5 0 0 0 0-9M12 19a10 10 0 0 0 0-14M15.5 21.5a13.5 13.5 0 0 0 0-19" /></svg>
        </div>
        <svg width="54" height="40" viewBox="0 0 54 40">
          <rect x="1" y="1" width="52" height="38" rx="7" fill="#d9c27a" />
          <path d="M1 14h16M1 26h16M37 14h16M37 26h16M17 1v38M37 1v38" stroke="#a88f45" stroke-width="1.4" />
        </svg>
        <div>
          <p class="font-mono text-[clamp(14px,4.2vw,19px)] tracking-[0.18em] opacity-90">•••• •••• •••• 2026</p>
          <div class="mt-2 flex items-end justify-between">
            <div>
              <p class="text-[9px] uppercase tracking-widest opacity-60">Crypto · Debit</p>
              <p class="text-[13px] font-semibold tracking-wider">YOUR NAME</p>
            </div>
            <svg width="54" height="32" viewBox="0 0 54 32"><circle cx="19" cy="16" r="14" fill="#2ee6a8" fill-opacity=".9" /><circle cx="35" cy="16" r="14" fill="#4c6ef5" fill-opacity=".85" /></svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .card3d {
    transform: rotateX(var(--rx, 8deg)) rotateY(var(--ry, -14deg));
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out;
    box-shadow:
      0 30px 60px -20px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(255 255 255 / 0.08) inset;
  }
  .card3d-shine {
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.16) var(--gx, 45%), transparent 62%);
    mix-blend-mode: screen;
  }
  .card3d-float {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
</style>
