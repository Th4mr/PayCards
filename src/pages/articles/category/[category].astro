---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CategoryTabs from '../../../components/CategoryTabs.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import CTABox from '../../../components/CTABox.astro';
import { CATEGORIES, type CategoryKey } from '../../../config';
import { getArticles, breadcrumbSchema, faqSchema } from '../../../lib/articles';
import FeaturedGuides from '../../../components/FeaturedGuides.astro';
import FAQ from '../../../components/FAQ.astro';
import { categoryCopy } from '../../../data/hub-copy';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}
const category = Astro.params.category as CategoryKey;
const cat = CATEGORIES[category];
const all = await getArticles();
const list = all.filter((a) => a.data.category === category);
const counts = all.reduce<Record<string, number>>((m, a) => ((m[a.data.category] = (m[a.data.category] ?? 0) + 1), m), {});
const crumbs = [{ name: 'الرئيسية', url: '/' }, { name: 'المقالات', url: '/articles' }, { name: cat.label, url: `/articles/category/${category}` }];
const copy = categoryCopy.ar[category];
---
<BaseLayout title={`مقالات ${cat.label}`} description={`${cat.label}: ${cat.description}`} page={`category:${category}`} schema={[breadcrumbSchema(crumbs), faqSchema([...copy.faq])]} noindex={list.length === 0}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">{cat.label}</h1>
    <p class="mt-3 max-w-3xl leading-8 text-muted">{cat.description}</p>
    <p class="mt-3 max-w-3xl leading-8">{copy.detail}</p>
    <FeaturedGuides heading={copy.featuredHeading} lead="" items={[...copy.featured]} />
    <div class="mt-8"><CategoryTabs active={category} counts={counts} total={all.length} /></div>
    {list.length ? (
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{list.map((a) => <ArticleCard article={a} />)}</div>
    ) : (
      <div class="card mt-8 p-10 text-center">
        <p class="text-lg font-bold">مقالات هذا القسم قيد الإعداد</p>
        <p class="mt-2 text-muted">إلى ذلك الحين، تصفّح <a href="/articles" class="text-accent-fg underline">كل المقالات</a>.</p>
      </div>
    )}
    <h2 class="mt-12 text-2xl font-extrabold">أسئلة هذا القسم</h2>
    <div class="mt-4 max-w-3xl"><FAQ items={[...copy.faq]} /></div>
    <div class="mx-auto max-w-3xl"><CTABox position="end" /></div>
  </section>
</BaseLayout>
