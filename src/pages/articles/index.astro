---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CTABox from '../../components/CTABox.astro';
import RedotHub from '../../components/RedotHub.astro';
import { getArticles, breadcrumbSchema, faqSchema } from '../../lib/articles';
import FeaturedGuides from '../../components/FeaturedGuides.astro';
import FAQ from '../../components/FAQ.astro';
import { articlesIndexCopy } from '../../data/hub-copy';

const all = await getArticles();
const hub = articlesIndexCopy.ar;
const counts = all.reduce<Record<string, number>>((m, a) => ((m[a.data.category] = (m[a.data.category] ?? 0) + 1), m), {});
const crumbs = [{ name: 'الرئيسية', url: '/' }, { name: 'المقالات', url: '/articles' }];
---
<BaseLayout title="كل المقالات: أدلة الدفع بالعملات الرقمية" description="أدلة ومقالات عربية عن بطاقة RedotPay والدفع بالعملات الرقمية: التسجيل، الشحن بـ USDT، الرسوم، الاشتراكات والتسوق، ومقارنات صريحة." page="articles" schema={[breadcrumbSchema(crumbs), faqSchema([...hub.faq])]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">كل المقالات</h1>
    <p class="mt-3 max-w-3xl leading-8 text-muted">أدلة عملية عن الدفع بالعملات الرقمية في الحياة اليومية، مرتبة حسب التصنيف. غياب بلدك عن قائمة المنع ليس موافقة، وصفحة الجزائر ليست خطوة تسجيل.</p>
    <FeaturedGuides heading={hub.heading} lead={hub.lead} items={[...hub.items]} />
    <h2 class="mt-12 text-2xl font-extrabold">{hub.faqHeading}</h2>
    <div class="mt-4 max-w-3xl"><FAQ items={[...hub.faq]} /></div>
    <div class="mt-8"><CategoryTabs counts={counts} total={all.length} /></div>
    <div class="mt-8"><RedotHub /></div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((a) => <ArticleCard article={a} />)}
    </div>
    <div class="mx-auto max-w-3xl"><CTABox position="end" /></div>
  </section>
</BaseLayout>
