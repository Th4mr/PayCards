---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import GuideSections from '../../../components/GuideSections.astro';
import { getArticles } from '../../../lib/fr-articles';
import { breadcrumbSchema, faqSchema } from '../../../lib/articles';
import FeaturedGuides from '../../../components/FeaturedGuides.astro';
import FAQ from '../../../components/FAQ.astro';
import { articlesIndexCopy } from '../../../data/hub-copy';

const all = await getArticles();
const hub = articlesIndexCopy.fr;
const crumbs = [{ name: 'Accueil', url: '/fr' }, { name: 'Tous les guides', url: '/fr/articles' }];
---
<BaseLayout lang="fr" title="Tous les guides : carte crypto, USDT, frais" description="Tous les guides en français, classés par catégorie : choisir une carte crypto, carte virtuelle, Visa prépayée, dépenser des USDT, KYC, cash, frais et pays." page="articles-fr" schema={[breadcrumbSchema(crumbs), faqSchema([...hub.faq])]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} lang="fr" />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Tous les guides</h1>
    <p class="mt-3 max-w-3xl leading-7 text-muted">Toutes les pages en français, classées par catégorie. Le parcours RedotPay si vous connaissez déjà la marque, ou une question plus large : dépenser des USDT, choisir une carte crypto, retirer du cash. L’absence d’un pays sur une liste n’est pas un accord, et les résidents du Maroc ne reçoivent pas de carte.</p>
    <FeaturedGuides heading={hub.heading} lead={hub.lead} items={[...hub.items]} />
    <h2 class="mt-12 text-2xl font-extrabold">{hub.faqHeading}</h2>
    <div class="mt-4 max-w-3xl"><FAQ items={[...hub.faq]} /></div>
    <div class="mt-8"><RedotHub lang="fr" /></div>
    <GuideSections lang="fr" articles={all} />
    <div class="mx-auto max-w-3xl"><CTABox lang="fr" position="end" /></div>
  </section>
</BaseLayout>
