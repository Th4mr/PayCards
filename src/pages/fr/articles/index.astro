---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import GuideSections from '../../../components/GuideSections.astro';
import { getArticles } from '../../../lib/fr-articles';
import { breadcrumbSchema } from '../../../lib/articles';

const all = await getArticles();
const crumbs = [{ name: 'Accueil', url: '/fr' }, { name: 'Tous les guides', url: '/fr/articles' }];
---
<BaseLayout lang="fr" title="Tous les guides : carte crypto, USDT, frais" description="Tous les guides en français, classés par catégorie : choisir une carte crypto, carte virtuelle, Visa prépayée, dépenser des USDT, KYC, cash, frais et pays." page="articles-fr" schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} lang="fr" />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Tous les guides</h1>
    <p class="mt-3 max-w-2xl text-muted">Toutes les pages en français, classées par catégorie. Le parcours RedotPay si vous connaissez déjà la marque, ou une question plus large : dépenser des USDT, choisir une carte crypto, retirer du cash.</p>
    <div class="mt-8"><RedotHub lang="fr" /></div>
    <GuideSections lang="fr" articles={all} />
    <div class="mx-auto max-w-3xl"><CTABox lang="fr" position="end" /></div>
  </section>
</BaseLayout>
