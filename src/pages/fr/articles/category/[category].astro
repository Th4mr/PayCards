---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import CTABox from '../../../../components/CTABox.astro';
import { getArticles, categoryLabel } from '../../../../lib/fr-articles';
import { breadcrumbSchema } from '../../../../lib/articles';

const KEYS = ['guides', 'use-cases', 'comparisons', 'troubleshooting'] as const;
const BLURB: Record<(typeof KEYS)[number], string> = {
  guides: 'Frais, pays, recharges, cartes virtuelle et physique, KYC, et passer d’un solde au cash.',
  'use-cases': 'Dépenses du quotidien en crypto. Un commerçant peut encore refuser la carte.',
  comparisons: 'Comment choisir, avec les chiffres publiés de RedotPay et les pages officielles des autres.',
  troubleshooting: 'Refus de paiement et les vérifications qui les expliquent le plus souvent.',
};

export function getStaticPaths() {
  return ['guides', 'use-cases', 'comparisons', 'troubleshooting'].map((category) => ({ params: { category } }));
}

const category = Astro.params.category as (typeof KEYS)[number];
const all = await getArticles();
const list = all.filter((a) => a.data.category === category);
const label = categoryLabel(category);
const crumbs = [
  { name: 'Accueil', url: '/fr' },
  { name: 'Tous les guides', url: '/fr/articles' },
  { name: label, url: `/fr/articles/category/${category}` },
];
---
<BaseLayout lang="fr" title={`${label} : tous les guides`} description={BLURB[category]} page={`category-fr:${category}`} schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} lang="fr" />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">{label}</h1>
    <p class="mt-3 max-w-2xl text-muted">{BLURB[category]}</p>
    <nav aria-label="Catégories" class="-mx-4 mt-8 overflow-x-auto px-4">
      <ul class="flex gap-2 whitespace-nowrap">
        <li><a href="/fr/articles" class="inline-flex rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold hover:border-accent/60">Tous les guides</a></li>
        {KEYS.map((key) => (
          <li>
            <a href={`/fr/articles/category/${key}`} aria-current={key === category ? 'page' : undefined}
              class:list={['inline-flex rounded-full border px-4 py-2 text-sm font-semibold', key === category ? 'border-accent bg-accent text-on-accent' : 'border-line bg-surface hover:border-accent/60']}>
              {categoryLabel(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((a) => <ArticleCard lang="fr" article={a} />)}
    </div>
    <div class="mx-auto max-w-3xl"><CTABox lang="fr" position="end" /></div>
  </section>
</BaseLayout>
