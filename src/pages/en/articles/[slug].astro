---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Cover from '../../../components/Cover.astro';
import CTABox from '../../../components/CTABox.astro';
import CTAButton from '../../../components/CTAButton.astro';
import FAQ from '../../../components/FAQ.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import FeeTable from '../../../components/FeeTable.astro';
import ReferralCode from '../../../components/ReferralCode.astro';
import AvailabilityNote from '../../../components/AvailabilityNote.astro';
import CountryLists from '../../../components/CountryLists.astro';
import RedotHub from '../../../components/RedotHub.astro';
import {
  getArticles,
  readingMinutes,
  readingLabel,
  formatDate,
  categoryLabel,
  relatedArticles,
  articleSchema,
  howToSchema,
  articleUrl,
  type ArticleEn,
} from '../../../lib/en-articles';
import { breadcrumbSchema, faqSchema } from '../../../lib/articles';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((article) => ({ params: { slug: article.id }, props: { article, all } }));
}

interface Props { article: ArticleEn; all: ArticleEn[]; }
const { article, all } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);

const minutes = readingMinutes(article.body);
const updated = data.updatedDate ?? data.pubDate;
const related = await relatedArticles(article, all);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
if (data.faq.length) toc.push({ depth: 2, slug: 'faq', text: 'FAQ' });

const crumbs = [
  { name: 'Home', url: '/en' },
  { name: 'Guides', url: '/en/articles' },
  { name: categoryLabel(data.category), url: `/en/articles/category/${data.category}` },
  { name: data.h1 ?? data.title, url: articleUrl(article) },
];
const schema = [articleSchema(article), breadcrumbSchema(crumbs)];
if (data.faq.length) schema.push(faqSchema(data.faq));
if (data.howto?.length) schema.push(howToSchema(data.h1 ?? data.title, data.description, data.howto));
---
<BaseLayout
  lang="en"
  title={data.title}
  description={data.description}
  page={`article-en:${article.id}`}
  type="article"
  image={`/og/en-${article.id}.png`}
  schema={schema}
  published={data.pubDate}
  modified={data.updatedDate}
>
  <article class="container-x pt-6 sm:pt-10">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_16rem]">
      <div class="min-w-0 mx-auto w-full max-w-3xl">
        <header>
          <Breadcrumbs items={crumbs} lang="en" />
          <a href={`/en/articles/category/${data.category}`} class="eyebrow mt-6">{categoryLabel(data.category)}</a>
          <h1 class="mt-4 text-3xl font-extrabold leading-[1.25] sm:text-[2.6rem]">{data.h1 ?? data.title}</h1>
          <p class="mt-4 text-lg text-muted">{data.description}</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
            <span>Published <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time></span>
            {data.updatedDate && <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
            <span>{readingLabel(minutes)}</span>
          </div>
        </header>

        <Cover icon={data.cover.icon} hue={data.cover.hue} size="lg" label={data.h1 ?? data.title} class="mt-8 aspect-[2.4] rounded-3xl border border-line" />

        <section aria-label="Short answer" class="mt-10 rounded-2xl border border-accent/40 bg-surface p-5 sm:p-6">
          <p class="flex items-center gap-2 text-sm font-bold text-accent-fg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
            Short answer
          </p>
          <p class="mt-2 leading-8">{data.summary}</p>
          <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
            <CTAButton lang="en" position="summary" label="Get your card" />
          </div>
        </section>

        {toc.length > 2 && (
          <details class="mt-6 rounded-2xl border border-line bg-surface lg:hidden">
            <summary class="flex cursor-pointer items-center justify-between px-5 py-4 font-bold">On this page <span class="faq-icon text-accent-fg transition-transform">+</span></summary>
            <ol class="space-y-2 px-5 pb-5 text-sm">
              {toc.map((h) => <li class={h.depth === 3 ? 'ps-4 text-muted' : ''}><a href={`#${h.slug}`} class="hover:text-accent-fg">{h.text}</a></li>)}
            </ol>
          </details>
        )}

        <div class="prose prose-pc prose-lg mt-8 max-w-none prose-headings:font-extrabold prose-h2:mt-12 prose-h2:text-2xl prose-h3:text-xl prose-p:leading-8 prose-li:leading-8">
          <Content components={{ CTABox, CTAButton, FeeTable, ReferralCode, AvailabilityNote, CountryLists, RedotHub }} />

          {data.faq.length > 0 && (
            <>
              <h2 id="faq">FAQ</h2>
              <FAQ items={data.faq} />
            </>
          )}
        </div>

        <div class="mt-10"><RedotHub lang="en" /></div>
        <CTABox lang="en" position="end" />

        <p class="rounded-xl border border-line bg-surface-2 p-4 text-sm leading-7 text-muted">
          <strong class="text-fg">Note:</strong> PayCards is independent and is not part of RedotPay. Fees, limits, and country rules change, so confirm them in the official app before you pay. Crypto can lose value. This page is education, not financial advice. Links to RedotPay are <a href="/en/disclosure" class="underline">referral links</a>.
        </p>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-5">
          {toc.length > 2 && (
            <nav aria-label="On this page" class="rounded-2xl border border-line bg-surface p-5">
              <p class="font-bold">On this page</p>
              <ol class="mt-3 space-y-2 text-sm text-muted">
                {toc.map((h) => <li class={h.depth === 3 ? 'ps-3 text-[13px]' : ''}><a href={`#${h.slug}`} class="hover:text-accent-fg">{h.text}</a></li>)}
              </ol>
            </nav>
          )}
          <div class="rounded-2xl border border-line bg-surface p-5 text-center">
            <p class="text-sm font-bold">Open RedotPay</p>
            <p class="mt-1 text-xs leading-6 text-muted">Virtual card funded with crypto. Enter the code during signup if you use one.</p>
            <CTAButton lang="en" position="sidebar" label="Get your card" size="sm" full class="mt-3" />
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="container-x">
        <h2 id="related-title" class="section-title">Related guides</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((a) => <ArticleCard lang="en" article={a} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
