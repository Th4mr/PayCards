---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import GuideSections from '../../../components/GuideSections.astro';
import { getArticles } from '../../../lib/en-articles';
import { breadcrumbSchema } from '../../../lib/articles';

const all = await getArticles();
const crumbs = [{ name: 'Home', url: '/en' }, { name: 'All guides', url: '/en/articles' }];
---
<BaseLayout lang="en" title="All guides: crypto cards, USDT, and fees" description="Every English guide, grouped by category: choosing a crypto card, virtual and prepaid cards, spending USDT, KYC, cash, fees, and countries." page="articles-en" schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} lang="en" />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">All guides</h1>
    <p class="mt-3 max-w-2xl text-muted">Every English page on this site, grouped by category. Start with the RedotPay path if you already know the brand, or with a broader question such as spending USDT or choosing a crypto card.</p>
    <div class="mt-8"><RedotHub lang="en" /></div>
    <GuideSections lang="en" articles={all} />
    <div class="mx-auto max-w-3xl"><CTABox lang="en" position="end" /></div>
  </section>
</BaseLayout>
