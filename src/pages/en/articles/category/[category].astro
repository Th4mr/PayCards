---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import CTABox from '../../../../components/CTABox.astro';
import { getArticles, categoryLabel } from '../../../../lib/en-articles';
import { breadcrumbSchema } from '../../../../lib/articles';

const KEYS = ['guides', 'use-cases', 'comparisons', 'troubleshooting'] as const;
const BLURB: Record<(typeof KEYS)[number], string> = {
  guides: 'Fees, countries, top-ups, virtual and physical cards, KYC, and turning a balance into cash.',
  'use-cases': 'Everyday spending with crypto. A merchant can still decline the card.',
  comparisons: 'How to choose, using RedotPay’s published figures and official pages for everyone else.',
  troubleshooting: 'Declines and the checks that usually explain them.',
};

export function getStaticPaths() {
  return ['guides', 'use-cases', 'comparisons', 'troubleshooting'].map((category) => ({ params: { category } }));
}

const category = Astro.params.category as (typeof KEYS)[number];
const all = await getArticles();
const list = all.filter((a) => a.data.category === category);
const label = categoryLabel(category);
const crumbs = [
  { name: 'Home', url: '/en' },
  { name: 'All guides', url: '/en/articles' },
  { name: label, url: `/en/articles/category/${category}` },
];
---
<BaseLayout lang="en" title={`${label}: all guides`} description={BLURB[category]} page={`category-en:${category}`} schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">{label}</h1>
    <p class="mt-3 max-w-2xl text-muted">{BLURB[category]}</p>
    <nav aria-label="Categories" class="-mx-4 mt-8 overflow-x-auto px-4">
      <ul class="flex gap-2 whitespace-nowrap">
        <li><a href="/en/articles" class="inline-flex rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold hover:border-accent/60">All guides</a></li>
        {KEYS.map((key) => (
          <li>
            <a href={`/en/articles/category/${key}`} aria-current={key === category ? 'page' : undefined}
              class:list={['inline-flex rounded-full border px-4 py-2 text-sm font-semibold', key === category ? 'border-accent bg-accent text-on-accent' : 'border-line bg-surface hover:border-accent/60']}>
              {categoryLabel(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((a) => <ArticleCard lang="en" article={a} />)}
    </div>
    <div class="mx-auto max-w-3xl"><CTABox lang="en" position="end" /></div>
  </section>
</BaseLayout>
