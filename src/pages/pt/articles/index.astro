---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import GuideSections from '../../../components/GuideSections.astro';
import { getArticles } from '../../../lib/pt-articles';
import { breadcrumbSchema, faqSchema } from '../../../lib/articles';
import FeaturedGuides from '../../../components/FeaturedGuides.astro';
import FAQ from '../../../components/FAQ.astro';
import { articlesIndexCopy } from '../../../data/hub-copy';

const all = await getArticles();
const hub = articlesIndexCopy.pt;
const crumbs = [{ name: 'Início', url: '/pt' }, { name: 'Todos os guias', url: '/pt/articles' }];
---
<BaseLayout lang="pt" title="Todos os guias: cartão cripto, USDT, taxas" description="Todos os guias em português, por categoria: escolher um cartão cripto, cartão virtual, Visa pré-pago, gastar USDT, KYC, dinheiro, taxas e países." page="articles-pt" schema={[breadcrumbSchema(crumbs), faqSchema([...hub.faq])]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} lang="pt" />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Todos os guias</h1>
    <p class="mt-3 max-w-3xl leading-7 text-muted">Todas as páginas em português, agrupadas por categoria. O caminho da RedotPay se você já conhece a marca, ou uma pergunta mais ampla: gastar USDT, escolher um cartão cripto, converter em dinheiro. A Guiné-Bissau está nas listas. Brasil, Portugal, Angola e Moçambique não estão nomeados, e isso não é aceite.</p>
    <FeaturedGuides heading={hub.heading} lead={hub.lead} items={[...hub.items]} />
    <h2 class="mt-12 text-2xl font-extrabold">{hub.faqHeading}</h2>
    <div class="mt-4 max-w-3xl"><FAQ items={[...hub.faq]} /></div>
    <div class="mt-8"><RedotHub lang="pt" /></div>
    <GuideSections lang="pt" articles={all} />
    <div class="mx-auto max-w-3xl"><CTABox lang="pt" position="end" /></div>
  </section>
</BaseLayout>
