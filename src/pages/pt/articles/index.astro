---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import { getArticles } from '../../../lib/pt-articles';
import { breadcrumbSchema } from '../../../lib/articles';

const all = await getArticles();
const crumbs = [{ name: 'Início', url: '/pt' }, { name: 'Guias', url: '/pt/articles' }];
---
<BaseLayout lang="pt" title="Guias RedotPay: taxas, países, recarga" description="Guias RedotPay em português: cartão, taxas, código de indicação, países, recarga, saques no caixa eletrônico, Apple Pay e um comparativo que não inventa as taxas de outros cartões." page="articles-pt" schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Guias RedotPay</h1>
    <p class="mt-3 max-w-2xl text-muted">Páginas práticas para buscas em português: taxas, código de indicação, cartão RedotPay, recarga e saque no caixa eletrônico. As explicações gerais de cripto continuam no site em árabe.</p>
    <div class="mt-8"><RedotHub lang="pt" /></div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((a) => <ArticleCard lang="pt" article={a} />)}
    </div>
    <div class="mx-auto max-w-3xl"><CTABox lang="pt" position="end" /></div>
  </section>
</BaseLayout>
