---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import GuideSections from '../../../components/GuideSections.astro';
import { getArticles } from '../../../lib/pt-articles';
import { breadcrumbSchema } from '../../../lib/articles';

const all = await getArticles();
const crumbs = [{ name: 'Início', url: '/pt' }, { name: 'Todos os guias', url: '/pt/articles' }];
---
<BaseLayout lang="pt" title="Todos os guias: cartão cripto, USDT, taxas" description="Todos os guias em português, por categoria: escolher um cartão cripto, cartão virtual, Visa pré-pago, gastar USDT, KYC, dinheiro, taxas e países." page="articles-pt" schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Todos os guias</h1>
    <p class="mt-3 max-w-2xl text-muted">Todas as páginas em português, agrupadas por categoria. O caminho da RedotPay se você já conhece a marca, ou uma pergunta mais ampla: gastar USDT, escolher um cartão cripto, converter em dinheiro.</p>
    <div class="mt-8"><RedotHub lang="pt" /></div>
    <GuideSections lang="pt" articles={all} />
    <div class="mx-auto max-w-3xl"><CTABox lang="pt" position="end" /></div>
  </section>
</BaseLayout>
