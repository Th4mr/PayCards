---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import GuideSections from '../../../components/GuideSections.astro';
import { getArticles } from '../../../lib/es-articles';
import { breadcrumbSchema, faqSchema } from '../../../lib/articles';
import FeaturedGuides from '../../../components/FeaturedGuides.astro';
import FAQ from '../../../components/FAQ.astro';
import { articlesIndexCopy } from '../../../data/hub-copy';

const all = await getArticles();
const hub = articlesIndexCopy.es;
const crumbs = [{ name: 'Inicio', url: '/es' }, { name: 'Todas las guías', url: '/es/articles' }];
---
<BaseLayout lang="es" title="Todas las guías: tarjeta cripto, USDT, comisiones" description="Todas las guías en español, por categoría: elegir una tarjeta cripto, tarjeta virtual, Visa prepago, gastar USDT, KYC, efectivo, comisiones y países." page="articles-es" schema={[breadcrumbSchema(crumbs), faqSchema([...hub.faq])]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} lang="es" />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Todas las guías</h1>
    <p class="mt-3 max-w-3xl leading-7 text-muted">Todas las páginas en español, agrupadas por categoría. El recorrido RedotPay si ya conoces la marca, o una pregunta más amplia: gastar USDT, elegir una tarjeta cripto, pasar a efectivo. Cuba, Nicaragua y Venezuela están en las listas de bloqueo. Que un país no aparezca no es una aceptación.</p>
    <FeaturedGuides heading={hub.heading} lead={hub.lead} items={[...hub.items]} />
    <h2 class="mt-12 text-2xl font-extrabold">{hub.faqHeading}</h2>
    <div class="mt-4 max-w-3xl"><FAQ items={[...hub.faq]} /></div>
    <div class="mt-8"><RedotHub lang="es" /></div>
    <GuideSections lang="es" articles={all} />
    <div class="mx-auto max-w-3xl"><CTABox lang="es" position="end" /></div>
  </section>
</BaseLayout>
