---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import { getArticles } from '../../../lib/es-articles';
import { breadcrumbSchema } from '../../../lib/articles';

const all = await getArticles();
const crumbs = [{ name: 'Inicio', url: '/es' }, { name: 'Guías', url: '/es/articles' }];
---
<BaseLayout lang="es" title="Guías RedotPay: comisiones, países, recarga" description="Guías RedotPay en español: opiniones, comisiones, código de referido, países, recarga, retiros en cajero, Apple Pay y una comparativa que no inventa las comisiones de otras tarjetas." page="articles-es" schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Guías RedotPay</h1>
    <p class="mt-3 max-w-2xl text-muted">Páginas prácticas para búsquedas en español: comisiones, código de referido, tarjeta RedotPay, recarga y retiro en cajero. Las explicaciones cripto generales siguen en el sitio en árabe.</p>
    <div class="mt-8"><RedotHub lang="es" /></div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((a) => <ArticleCard lang="es" article={a} />)}
    </div>
    <div class="mx-auto max-w-3xl"><CTABox lang="es" position="end" /></div>
  </section>
</BaseLayout>
