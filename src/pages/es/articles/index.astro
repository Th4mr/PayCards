---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABox from '../../../components/CTABox.astro';
import RedotHub from '../../../components/RedotHub.astro';
import GuideSections from '../../../components/GuideSections.astro';
import { getArticles } from '../../../lib/es-articles';
import { breadcrumbSchema } from '../../../lib/articles';

const all = await getArticles();
const crumbs = [{ name: 'Inicio', url: '/es' }, { name: 'Todas las guías', url: '/es/articles' }];
---
<BaseLayout lang="es" title="Todas las guías: tarjeta cripto, USDT, comisiones" description="Todas las guías en español, por categoría: elegir una tarjeta cripto, tarjeta virtual, Visa prepago, gastar USDT, KYC, efectivo, comisiones y países." page="articles-es" schema={[breadcrumbSchema(crumbs)]}>
  <section class="container-x pt-8 sm:pt-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-5 text-3xl font-extrabold sm:text-4xl">Todas las guías</h1>
    <p class="mt-3 max-w-2xl text-muted">Todas las páginas en español, agrupadas por categoría. El recorrido RedotPay si ya conoces la marca, o una pregunta más amplia: gastar USDT, elegir una tarjeta cripto, pasar a efectivo.</p>
    <div class="mt-8"><RedotHub lang="es" /></div>
    <GuideSections lang="es" articles={all} />
    <div class="mx-auto max-w-3xl"><CTABox lang="es" position="end" /></div>
  </section>
</BaseLayout>
