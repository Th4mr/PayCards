---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, articleUrl } from '../lib/articles';
import { getArticles as getEnglish, articleUrl as enUrl } from '../lib/en-articles';
import { getArticles as getFrench, articleUrl as frUrl } from '../lib/fr-articles';
import { getArticles as getSpanish, articleUrl as esUrl } from '../lib/es-articles';

const popularAr = (await getArticles()).slice(0, 4);
const popularEn = (await getEnglish()).slice(0, 4);
const popularFr = (await getFrench()).slice(0, 4);
const popularEs = (await getSpanish()).slice(0, 4);
---
<BaseLayout title="404 | PayCards" description="Page introuvable." page="404" noindex detectLang>
  <section data-ui-block="ar" class="container-x max-w-2xl py-20 text-center">
    <p class="bg-gradient-to-l from-accent-fg to-[#4c6ef5] bg-clip-text text-8xl font-extrabold text-transparent" dir="ltr">404</p>
    <h1 class="mt-4 text-2xl font-extrabold sm:text-3xl">يبدو أن هذه البطاقة رُفضت!</h1>
    <p class="mt-3 text-muted">الصفحة التي تبحث عنها غير موجودة أو نُقلت. لا تقلق، لم تُخصم أي رسوم 🙂</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-primary">العودة إلى الرئيسية</a>
      <a href="/articles" class="btn-ghost">تصفّح المقالات</a>
    </div>
    <div class="card mt-12 p-6 text-start">
      <p class="font-bold">ربما تبحث عن:</p>
      <ul class="mt-3 space-y-2">
        {popularAr.map((a) => <li><a href={articleUrl(a)} class="text-accent-fg hover:underline">{a.data.h1 ?? a.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  <section data-ui-block="en" class="container-x max-w-2xl py-20 text-center">
    <p class="bg-gradient-to-r from-accent-fg to-[#4c6ef5] bg-clip-text text-8xl font-extrabold text-transparent" dir="ltr">404</p>
    <h1 class="mt-4 text-2xl font-extrabold sm:text-3xl">This card was declined.</h1>
    <p class="mt-3 text-muted">The page you wanted is missing or has moved. Nothing was charged.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/en" class="btn-primary">Back to the English home</a>
      <a href="/en/articles" class="btn-ghost">Browse guides</a>
    </div>
    <div class="card mt-12 p-6 text-start">
      <p class="font-bold">You might be looking for:</p>
      <ul class="mt-3 space-y-2">
        {popularEn.map((a) => <li><a href={enUrl(a)} class="text-accent-fg hover:underline">{a.data.h1 ?? a.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  <section data-ui-block="fr" class="container-x max-w-2xl py-20 text-center">
    <p class="bg-gradient-to-r from-accent-fg to-[#4c6ef5] bg-clip-text text-8xl font-extrabold text-transparent" dir="ltr">404</p>
    <h1 class="mt-4 text-2xl font-extrabold sm:text-3xl">Cette carte a été refusée.</h1>
    <p class="mt-3 text-muted">La page que vous cherchez n’existe pas ou a été déplacée. Aucun frais n’a été prélevé.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/fr" class="btn-primary">Retour à l’accueil français</a>
      <a href="/fr/articles" class="btn-ghost">Voir les guides</a>
    </div>
    <div class="card mt-12 p-6 text-start">
      <p class="font-bold">Vous cherchez peut-être :</p>
      <ul class="mt-3 space-y-2">
        {popularFr.map((a) => <li><a href={frUrl(a)} class="text-accent-fg hover:underline">{a.data.h1 ?? a.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  <section data-ui-block="es" class="container-x max-w-2xl py-20 text-center">
    <p class="bg-gradient-to-r from-accent-fg to-[#4c6ef5] bg-clip-text text-8xl font-extrabold text-transparent" dir="ltr">404</p>
    <h1 class="mt-4 text-2xl font-extrabold sm:text-3xl">Esta tarjeta fue rechazada.</h1>
    <p class="mt-3 text-muted">La página que buscas no existe o se ha movido. No se ha cobrado nada.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/es" class="btn-primary">Volver al inicio en español</a>
      <a href="/es/articles" class="btn-ghost">Ver las guías</a>
    </div>
    <div class="card mt-12 p-6 text-start">
      <p class="font-bold">Quizá buscas:</p>
      <ul class="mt-3 space-y-2">
        {popularEs.map((a) => <li><a href={esUrl(a)} class="text-accent-fg hover:underline">{a.data.h1 ?? a.data.title}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
