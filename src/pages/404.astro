---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, articleUrl } from '../lib/articles';
const popular = (await getArticles()).slice(0, 4);
---
<BaseLayout title="الصفحة غير موجودة" description="الصفحة التي تبحث عنها غير موجودة." page="404" noindex>
  <section class="container-x max-w-2xl py-20 text-center">
    <p class="bg-gradient-to-l from-accent-fg to-[#4c6ef5] bg-clip-text text-8xl font-extrabold text-transparent" dir="ltr">404</p>
    <h1 class="mt-4 text-2xl font-extrabold sm:text-3xl">يبدو أن هذه البطاقة رُفضت!</h1>
    <p class="mt-3 text-muted">الصفحة التي تبحث عنها غير موجودة أو نُقلت. لا تقلق، لم تُخصم أي رسوم 🙂</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-primary">العودة إلى الرئيسية</a>
      <a href="/articles" class="btn-ghost">تصفّح المقالات</a>
    </div>
    <div class="card mt-12 p-6 text-start">
      <p class="font-bold">ربما تبحث عن:</p>
      <ul class="mt-3 space-y-2">
        {popular.map((a) => <li><a href={articleUrl(a)} class="text-accent-fg hover:underline">{a.data.h1 ?? a.data.title}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
