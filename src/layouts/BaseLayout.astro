---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, SITE_EN, SITE_FR, SITE_ES, SITE_PT, ANALYTICS } from '../config';
import { pairFor, normalizePath } from '../i18n/routes';
import { isLtr, text, type Lang } from '../i18n/lang';

interface Props {
  title: string;
  description?: string;
  page: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  lang?: Lang;
  /** صفحة 404: تختار اللغة من مسار المتصفح وتعرض الواجهة المناسبة. */
  detectLang?: boolean;
}

const {
  title,
  description = text(Astro.props.lang ?? 'ar', { ar: SITE.description, en: SITE_EN.description, fr: SITE_FR.description, es: SITE_ES.description, pt: SITE_PT.description }),
  page,
  lang = 'ar',
  image = text(lang, { ar: '/og/site.png', en: '/og/en-site.png', fr: '/og/fr-site.png', es: '/og/es-site.png', pt: '/og/pt-site.png' }),
  type = 'website',
  schema = [],
  noindex = false,
  published,
  modified,
  detectLang = false,
} = Astro.props;

const fullTitle = title.includes('PayCards') ? title : `${title} | PayCards`;
const cleanPath = normalizePath(Astro.url.pathname);
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const pair = pairFor(cleanPath);
const fontSans = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600;700&display=swap';
const fontArabic = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap';
const fontHref = isLtr(lang) ? fontSans : fontArabic;
const locale = text(lang, { ar: SITE.locale, en: SITE_EN.locale, fr: SITE_FR.locale, es: SITE_ES.locale, pt: SITE_PT.locale });
const ogLocales = { ar: SITE.locale, en: SITE_EN.locale, fr: SITE_FR.locale, es: SITE_ES.locale, pt: SITE_PT.locale } as const;
const altLocales = (['ar', 'en', 'fr', 'es', 'pt'] as const).filter((code) => code !== lang && pair?.[code]);
---
<!doctype html>
<html lang={lang} dir={isLtr(lang) ? 'ltr' : 'rtl'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {pair?.ar && <link rel="alternate" hreflang="ar" href={new URL(pair.ar, SITE.url).href} />}
    {pair?.en && <link rel="alternate" hreflang="en" href={new URL(pair.en, SITE.url).href} />}
    {pair?.fr && <link rel="alternate" hreflang="fr" href={new URL(pair.fr, SITE.url).href} />}
    {pair?.es && <link rel="alternate" hreflang="es" href={new URL(pair.es, SITE.url).href} />}
    {pair?.pt && <link rel="alternate" hreflang="pt" href={new URL(pair.pt, SITE.url).href} />}
    {pair?.ar && <link rel="alternate" hreflang="x-default" href={new URL(pair.ar, SITE.url).href} />}
    {!pair?.ar && pair?.en && pair?.fr && <link rel="alternate" hreflang="x-default" href={new URL(pair.en, SITE.url).href} />}
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f5f7fb" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale} />
    {altLocales.map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {detectLang && (
      <>
        <script is:inline>
          (function () {
            var p = location.pathname;
            var lang = (p === '/pt' || p.indexOf('/pt/') === 0) ? 'pt' : (p === '/es' || p.indexOf('/es/') === 0) ? 'es' : (p === '/fr' || p.indexOf('/fr/') === 0) ? 'fr' : (p === '/en' || p.indexOf('/en/') === 0) ? 'en' : 'ar';
            var d = document.documentElement;
            d.lang = lang;
            d.dir = lang === 'ar' ? 'rtl' : 'ltr';
            d.setAttribute('data-ui', lang);
          })();
        </script>
        <style is:inline>
          html[data-ui="ar"] [data-ui-block]:not([data-ui-block="ar"]),
          html[data-ui="en"] [data-ui-block]:not([data-ui-block="en"]),
          html[data-ui="fr"] [data-ui-block]:not([data-ui-block="fr"]),
          html[data-ui="es"] [data-ui-block]:not([data-ui-block="es"]),
          html[data-ui="pt"] [data-ui-block]:not([data-ui-block="pt"]) { display: none !important; }
          html[data-ui="ar"] [data-ui-block="ar"],
          html[data-ui="en"] [data-ui-block="en"],
          html[data-ui="fr"] [data-ui-block="fr"],
          html[data-ui="es"] [data-ui-block="es"],
          html[data-ui="pt"] [data-ui-block="pt"] { display: contents; }
        </style>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {detectLang ? (
      <>
        <link rel="stylesheet" href={fontSans} />
        <link rel="stylesheet" href={fontArabic} />
      </>
    ) : (
      <>
        <link rel="preload" as="style" href={fontHref} />
        <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
        <noscript><link rel="stylesheet" href={fontHref} /></noscript>
      </>
    )}

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (localStorage.getItem('pc-theme') === 'dark') d.classList.add('dark');
          if (localStorage.getItem('pc-topbar') === '1') d.classList.add('topbar-off');
          if (sessionStorage.getItem('pc-sticky') === '1') d.classList.add('sticky-off');
          if (localStorage.getItem('pc-consent')) d.classList.add('consent-set');
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      .topbar-off .topbar, .sticky-off .sticky-cta { display: none !important; }
    </style>

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {ANALYTICS.headHtml && <Fragment set:html={ANALYTICS.headHtml} />}
  </head>
  <body data-page={page} class="bg-grid min-h-dvh bg-no-repeat">
    {detectLang ? (
      (['ar', 'en', 'fr', 'es', 'pt'] as const).map((ui) => (
        <div data-ui-block={ui}>
          <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-[60] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent">{text(ui, { ar: 'تخطَّ إلى المحتوى', en: 'Skip to content', fr: 'Aller au contenu', es: 'Saltar al contenido', pt: 'Pular para o conteúdo' })}</a>
          <TopBar lang={ui} />
          <Header lang={ui} />
        </div>
      ))
    ) : (
      <>
        <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-[60] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent">{text(lang, { ar: 'تخطَّ إلى المحتوى', en: 'Skip to content', fr: 'Aller au contenu', es: 'Saltar al contenido', pt: 'Pular para o conteúdo' })}</a>
        <TopBar lang={lang} />
        <Header lang={lang} />
      </>
    )}
    <main id="main">
      <slot />
    </main>
    {detectLang ? (
      (['ar', 'en', 'fr', 'es', 'pt'] as const).map((ui) => (
        <div data-ui-block={ui}>
          <Footer lang={ui} />
          <StickyCTA lang={ui} />
          <CookieConsent lang={ui} />
        </div>
      ))
    ) : (
      <>
        <Footer lang={lang} />
        <StickyCTA lang={lang} />
        <CookieConsent lang={lang} />
      </>
    )}

    <script is:inline>
      (function () {
        document.querySelectorAll('.prose-pc table').forEach(function (table) {
          var heads = Array.prototype.map.call(table.querySelectorAll('thead th'), function (th) {
            return (th.textContent || '').replace(/\s+/g, ' ').trim();
          });
          table.querySelectorAll('tbody tr').forEach(function (tr) {
            Array.prototype.forEach.call(tr.children, function (cell, i) {
              if (heads[i]) cell.setAttribute('data-label', heads[i]);
            });
          });
        });
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nodes = document.querySelectorAll('.reveal');
        if (reduce) {
          nodes.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var h = window.innerHeight * 0.96;
        nodes.forEach(function (el) {
          var r = el.getBoundingClientRect();
          if (r.top < h && r.bottom > 0) el.classList.add('is-in');
        });
        document.documentElement.classList.add('reveal-arm');
      })();
    </script>
    <script>
      import { initSite } from '../lib/site';
      initSite();
    </script>
  </body>
</html>
