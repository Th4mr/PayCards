---
interface Props { items: { name: string; url?: string }[]; }
const { items } = Astro.props;
---
<nav aria-label="مسار التنقل" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((it, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="opacity-50">‹</span>}
        {it.url && i < items.length - 1 ? <a href={it.url} class="hover:text-fg">{it.name}</a> : <span aria-current="page" class="text-fg/80 line-clamp-1">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
