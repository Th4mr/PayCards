---
import { text, type Lang } from '../i18n/lang';
interface Props { class?: string; lang?: Lang; }
const { class: cls = '', lang = 'ar' } = Astro.props;
const href = text(lang, {
  ar: '/articles/redotpay-supported-countries',
  en: '/en/articles/redotpay-supported-countries',
  fr: '/fr/articles/pays-redotpay',
});
---
<p class:list={['text-xs leading-6 text-muted', cls]}>
  {lang === 'fr' ? (
    <>Pas de carte pour les résidents des États-Unis, et l’app ne s’ouvre pas si vous y êtes. Les citoyens américains ne finissent pas le KYC. Les résidents au Maroc ne reçoivent pas de carte. La carte physique n’est pas livrée en Tunisie. Un pays absent d’une liste n’est pas accepté.{' '}<a href={href} class="underline">Listes des pays</a></>
  ) : lang === 'en' ? (
    <>RedotPay does not issue a card to US residents, and the app does not open if you are located in the United States. In any other country, check the published lists and the app. A missing name is not approval.{' '}<a href={href} class="underline">Country lists</a></>
  ) : (
    <>قد لا تكون RedotPay، أو بطاقات العملات الرقمية عموماً، متاحة أو مسموحة في بعض الدول. تحقق من القواعد المحلية ومن التطبيق قبل التسجيل.{' '}<a href={href} class="underline">قائمة الدول المنشورة</a></>
  )}
</p>
