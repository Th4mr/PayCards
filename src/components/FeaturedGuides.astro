---
interface Item {
  href: string;
  title: string;
  text: string;
}
interface Props {
  heading: string;
  lead: string;
  items: Item[];
}
const { heading, lead, items } = Astro.props;
---
<section class="mt-10">
  <h2 class="text-2xl font-extrabold">{heading}</h2>
  {lead && <p class="mt-3 max-w-3xl leading-7 text-muted">{lead}</p>}
  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    {items.map((item) => (
      <li>
        <a href={item.href} class="card block h-full p-5 transition hover:border-accent/60">
          <h3 class="font-bold">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{item.text}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
