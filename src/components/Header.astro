---
import Logo from './Logo.astro';
import CTAButton from './CTAButton.astro';
import { NAV } from '../config';
import { switchLocales } from '../i18n/routes';
import { text, type Lang } from '../i18n/lang';

interface Props { lang?: Lang; }
const { lang = 'ar' } = Astro.props;
const others = switchLocales(Astro.url.pathname, lang);
const nav = text(lang, {
  ar: NAV,
  en: [
    { href: '/en/articles', label: 'Guides' },
    { href: '/en#fees', label: 'Fees' },
    { href: '/en#faq', label: 'FAQ' },
  ],
  fr: [
    { href: '/fr/articles', label: 'Guides' },
    { href: '/fr#frais', label: 'Frais' },
    { href: '/fr#faq', label: 'FAQ' },
  ],
});
const cta = text(lang, { ar: 'احصل على بطاقتك', en: 'Get your card', fr: 'Obtenir la carte' });
const homeHref = text(lang, { ar: '/', en: '/en', fr: '/fr' });
const homeLabel = text(lang, { ar: 'PayCards — الرئيسية', en: 'PayCards — Home', fr: 'PayCards — Accueil' });
const primary = text(lang, { ar: 'القائمة الرئيسية', en: 'Primary', fr: 'Principal' });
const themeLabel = text(lang, { ar: 'تبديل الوضع الداكن والفاتح', en: 'Toggle dark mode', fr: 'Changer le thème' });
const menuLabel = text(lang, { ar: 'فتح القائمة', en: 'Open menu', fr: 'Ouvrir le menu' });
const mobileLabel = text(lang, { ar: 'قائمة الجوال', en: 'Mobile', fr: 'Menu mobile' });
const langLabel = text(lang, { ar: 'اللغة', en: 'Language', fr: 'Langue' });
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between gap-2">
    <Logo href={homeHref} label={homeLabel} />
    <nav aria-label={primary} class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm font-semibold text-muted">
        {nav.map((l) => <li><a href={l.href} class="hover:text-fg transition">{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-1.5 sm:gap-2">
      <nav aria-label={langLabel} class="flex items-center gap-1">
        {others.map((o) => (
          <a href={o.href} hreflang={o.lang} lang={o.lang} class="grid h-10 min-w-10 place-items-center rounded-xl border border-line bg-surface px-2 text-xs font-bold text-muted hover:text-fg" aria-label={o.label}>{o.short}</a>
        ))}
      </nav>
      <button type="button" data-theme-toggle class="grid h-10 w-10 place-items-center rounded-xl border border-line bg-surface text-muted hover:text-fg" aria-label={themeLabel}>
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <CTAButton lang={lang} position="header" label={cta} size="sm" class="hidden lg:inline-flex" />
      <details class="relative md:hidden">
        <summary class="grid h-10 w-10 cursor-pointer place-items-center rounded-xl border border-line bg-surface" aria-label={menuLabel}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav aria-label={mobileLabel} class="absolute end-0 mt-2 w-56 rounded-2xl border border-line bg-surface p-2 shadow-2xl">
          <ul class="text-sm font-semibold">
            {nav.map((l) => <li><a href={l.href} class="block rounded-lg px-3 py-2.5 hover:bg-surface-2">{l.label}</a></li>)}
            {others.map((o) => <li><a href={o.href} hreflang={o.lang} lang={o.lang} class="block rounded-lg px-3 py-2.5 hover:bg-surface-2">{o.label}</a></li>)}
            <li class="p-1 pt-2"><CTAButton lang={lang} position="mobile-menu" label={cta} size="sm" full /></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
