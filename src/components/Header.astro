---
import Logo from './Logo.astro';
import CTAButton from './CTAButton.astro';
import { NAV } from '../config';
import { counterpart } from '../i18n/routes';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const otherHref = counterpart(Astro.url.pathname);
const otherLang = lang === 'en' ? 'ar' : 'en';
const nav = lang === 'en'
  ? [
      { href: '/en/articles', label: 'Guides' },
      { href: '/en/#fees', label: 'Fees' },
      { href: '/en/#faq', label: 'FAQ' },
    ]
  : NAV;
const cta = lang === 'en' ? 'Get your card' : 'احصل على بطاقتك';
const homeHref = lang === 'en' ? '/en' : '/';
const homeLabel = lang === 'en' ? 'PayCards — Home' : 'PayCards — الرئيسية';
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between gap-3">
    <Logo href={homeHref} label={homeLabel} />
    <nav aria-label={lang === 'en' ? 'Primary' : 'القائمة الرئيسية'} class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm font-semibold text-muted">
        {nav.map((l) => <li><a href={l.href} class="hover:text-fg transition">{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={otherHref} hreflang={otherLang} lang={otherLang} class="grid h-10 min-w-10 place-items-center rounded-xl border border-line bg-surface px-2 text-xs font-bold text-muted hover:text-fg" aria-label={lang === 'en' ? 'العربية' : 'English'}>
        {lang === 'en' ? 'عربي' : 'EN'}
      </a>
      <button type="button" data-theme-toggle class="grid h-10 w-10 place-items-center rounded-xl border border-line bg-surface text-muted hover:text-fg" aria-label={lang === 'en' ? 'Toggle dark mode' : 'تبديل الوضع الداكن والفاتح'}>
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <CTAButton lang={lang} position="header" label={cta} size="sm" class="hidden lg:inline-flex" />
      <details class="relative md:hidden">
        <summary class="grid h-10 w-10 cursor-pointer place-items-center rounded-xl border border-line bg-surface" aria-label={lang === 'en' ? 'Open menu' : 'فتح القائمة'}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav aria-label={lang === 'en' ? 'Mobile' : 'قائمة الجوال'} class="absolute end-0 mt-2 w-56 rounded-2xl border border-line bg-surface p-2 shadow-2xl">
          <ul class="text-sm font-semibold">
            {nav.map((l) => <li><a href={l.href} class="block rounded-lg px-3 py-2.5 hover:bg-surface-2">{l.label}</a></li>)}
            <li><a href={otherHref} hreflang={otherLang} lang={otherLang} class="block rounded-lg px-3 py-2.5 hover:bg-surface-2">{lang === 'en' ? 'العربية' : 'English'}</a></li>
            <li class="p-1 pt-2"><CTAButton lang={lang} position="mobile-menu" label={cta} size="sm" full /></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
