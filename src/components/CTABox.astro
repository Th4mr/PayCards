---
import CTAButton from './CTAButton.astro';

/**
 * صندوق دعوة قابل لإعادة الاستخدام داخل المقالات.
 * <CTABox />                      ← في منتصف المقال (position=inline)
 * <CTABox position="end" />       ← في نهاية المقال
 */
interface Props {
  position?: 'inline' | 'end' | string;
  title?: string;
  text?: string;
  button?: string;
}
const {
  position = 'inline',
  title = position === 'end' ? 'جاهز لتجربتها بنفسك؟' : 'جرّب البطاقة بنفسك',
  text = 'أنشئ حسابك في RedotPay خلال دقائق، ثم أصدر بطاقتك الافتراضية وابدأ الدفع من رصيدك الرقمي.',
  button = position === 'end' ? 'احصل على بطاقتك الآن' : 'ابدأ التسجيل',
} = Astro.props;
---
<aside class="not-prose relative my-10 overflow-hidden rounded-2xl border border-line bg-surface p-5 sm:p-7" aria-label="دعوة للتسجيل">
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -start-24 h-56 w-56 rounded-full bg-accent/20 blur-3xl"></div>
  <div class="relative grid gap-5 sm:grid-cols-[1fr_auto] sm:items-center">
    <div>
      <p class="text-lg font-extrabold">{title}</p>
      <p class="mt-1 text-muted">
        {text}
      </p>
    </div>
    <CTAButton position={position} label={button} size="lg" class="w-full sm:w-auto" />
  </div>
  <p class="relative mt-4 text-xs text-muted">يفتح التسجيل على منصة RedotPay الرسمية. <a href="/disclosure" class="underline">إفصاح الإحالة</a></p>
</aside>
