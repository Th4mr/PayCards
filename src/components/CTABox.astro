---
import CTAButton from './CTAButton.astro';
import ReferralCode from './ReferralCode.astro';
import AvailabilityNote from './AvailabilityNote.astro';
import { REFERRAL, REFERRAL_EN } from '../config';

interface Props {
  position?: 'inline' | 'end' | string;
  title?: string;
  text?: string;
  button?: string;
  lang?: 'ar' | 'en';
}
const { position = 'inline', lang = 'ar' } = Astro.props;
const ref = lang === 'en' ? REFERRAL_EN : REFERRAL;
const title = Astro.props.title ?? (lang === 'en'
  ? (position === 'end' ? 'Ready to open the account?' : 'Open the RedotPay account')
  : (position === 'end' ? 'جاهز لتجربتها بنفسك؟' : 'جرّب البطاقة بنفسك'));
const text = Astro.props.text ?? (lang === 'en'
  ? (ref.bonus
      ? `Create the account on RedotPay and enter the referral code during signup if you want to. The ${ref.bonus} spending reward for new accounts does not cover the card issuance fee, and it is not tied to the code.`
      : 'Create a RedotPay account, issue the virtual card, and pay from the crypto balance.')
  : (REFERRAL.bonus
      ? `أنشئ الحساب على RedotPay، وأدخل رمز الإحالة أثناء التسجيل إن أردت. مكافأة الإنفاق ${REFERRAL.bonus} للحسابات الجديدة لا تغطي رسم إصدار البطاقة، وليست مربوطة بالرمز.`
      : 'أنشئ حسابك في RedotPay خلال دقائق، ثم أصدر بطاقتك الافتراضية وابدأ الدفع من رصيدك الرقمي.'));
const button = Astro.props.button ?? (lang === 'en'
  ? (position === 'end' ? 'Get your card' : 'Start signup')
  : (position === 'end' ? 'احصل على بطاقتك الآن' : 'ابدأ التسجيل'));
const disclosure = lang === 'en' ? '/en/disclosure' : '/disclosure';
---
<aside class="not-prose relative my-10 overflow-hidden rounded-2xl border border-line bg-surface p-5 sm:p-7" aria-label={lang === 'en' ? 'Signup' : 'دعوة للتسجيل'}>
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -start-24 h-56 w-56 rounded-full bg-accent/20 blur-3xl"></div>
  <div class="relative grid gap-5 sm:grid-cols-[1fr_auto] sm:items-center">
    <div>
      <p class="text-lg font-extrabold">{title}</p>
      <p class="mt-1 text-muted">{text}</p>
    </div>
    <CTAButton lang={lang} position={position} label={button} size="lg" class="w-full sm:w-auto" />
  </div>
  <div class="relative mt-4"><ReferralCode lang={lang} placement={position} compact /></div>
  <AvailabilityNote lang={lang} class="relative mt-3" />
  <p class="relative mt-2 text-xs text-muted">
    {lang === 'en' ? (
      <>Signup opens on RedotPay. <a href={disclosure} class="underline">Referral disclosure</a></>
    ) : (
      <>يفتح التسجيل على منصة RedotPay الرسمية. <a href={disclosure} class="underline">إفصاح الإحالة</a></>
    )}
  </p>
</aside>
