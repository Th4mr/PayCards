---
import { REVIEWED_LABEL, SOURCES, feeRows, type SourceId } from '../data/redotpay';
import { REVIEWED_LABEL_EN, feeRowsEn, sourceEn } from '../data/fees-en';
import { REVIEWED_LABEL_FR, feeRowsFr, sourceFr } from '../data/fees-fr';
import { REVIEWED_LABEL_ES, feeRowsEs, sourceEs } from '../data/fees-es';
import { REVIEWED_LABEL_PT, feeRowsPt, sourcePt } from '../data/fees-pt';
import { text, type Lang } from '../i18n/lang';

interface Props {
  variant?: 'full' | 'compact';
  lang?: Lang;
}
const { variant = 'full', lang = 'ar' } = Astro.props;
const rows = text(lang, { ar: feeRows, en: feeRowsEn, fr: feeRowsFr, es: feeRowsEs, pt: feeRowsPt }).filter((r) => variant === 'compact' ? r.compact : true);
const used = new Set(rows.map((r) => r.sourceId).filter(Boolean) as SourceId[]);
const reviewed = text(lang, { ar: REVIEWED_LABEL, en: REVIEWED_LABEL_EN, fr: REVIEWED_LABEL_FR, es: REVIEWED_LABEL_ES, pt: REVIEWED_LABEL_PT });
---
<div class="not-prose">
  <p class="mb-3 text-sm leading-7 text-muted">
    {lang === 'pt' ? (
      <>Números conferidos em <time datetime="2026-10-24">{reviewed}</time> nas páginas oficiais da RedotPay ligadas sob a tabela. O valor que o aplicativo mostra antes de confirmar é a referência, porque as taxas mudam.</>
    ) : lang === 'es' ? (
      <>Cifras revisadas el <time datetime="2026-10-24">{reviewed}</time> en las páginas oficiales de RedotPay enlazadas bajo la tabla. El importe que muestra la app antes de confirmar es la referencia, porque las comisiones cambian.</>
    ) : lang === 'fr' ? (
      <>Chiffres vérifiés le <time datetime="2026-10-24">{reviewed}</time> sur les pages officielles RedotPay liées sous le tableau. Le montant affiché dans l’app avant confirmation fait foi, parce que les frais changent.</>
    ) : lang === 'en' ? (
      <>Figures checked on <time datetime="2026-10-24">{reviewed}</time> against the official RedotPay pages linked under the table. The amount shown in the app before you confirm is the final reference, because fees change.</>
    ) : (
      <>رُوجعت الأرقام في <time datetime="2026-10-24">{reviewed}</time> من صفحات RedotPay الرسمية المرتبطة أسفل الجدول. المبلغ الذي يظهر في التطبيق قبل التأكيد هو المرجع الأخير، لأن الرسوم تتغيّر.</>
    )}
  </p>
  {variant === 'full' && (
    <div class="space-y-3 md:hidden">
      {rows.map((row) => (
        <article class="rounded-2xl border border-line bg-surface p-4">
          <h3 class="text-sm font-bold">{row.item}</h3>
          <p class="mt-1 text-base font-extrabold leading-7">{row.value}</p>
          <p class="mt-2 text-sm leading-7 text-muted">{row.detail}</p>
        </article>
      ))}
    </div>
  )}
  <div class:list={['overflow-hidden rounded-2xl border border-line', variant === 'full' && 'hidden md:block']}>
    <table class="w-full table-fixed border-collapse text-sm">
      <thead class="bg-surface-2 text-start">
        <tr>
          <th class:list={['px-3 py-3 text-start font-bold', variant === 'full' ? 'w-[28%]' : 'w-[56%]']}>{text(lang, { ar: 'البند', en: 'Item', fr: 'Poste', es: 'Concepto', pt: 'Item' })}</th>
          <th class:list={['px-3 py-3 text-start font-bold', variant === 'full' ? 'w-[22%]' : 'w-[44%]']}>{text(lang, { ar: 'القيمة المنشورة', en: 'Published value', fr: 'Valeur publiée', es: 'Valor publicado', pt: 'Valor publicado' })}</th>
          {variant === 'full' && <th class="w-[50%] px-3 py-3 text-start font-bold">{text(lang, { ar: 'التفاصيل', en: 'Detail', fr: 'Détail', es: 'Detalle', pt: 'Detalhe' })}</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-t border-line align-top">
            <th class="px-3 py-3 text-start font-semibold break-words">{row.item}</th>
            <td class="px-3 py-3 font-bold break-words text-fg">{row.value}</td>
            {variant === 'full' && <td class="px-3 py-3 leading-7 break-words text-muted">{row.detail}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul class="mt-3 space-y-1 text-xs leading-6 text-muted">
    {[...used].map((id) => {
      if (lang === 'pt') {
        const s = sourcePt(id);
        return (
          <li>
            <a href={s.url} rel="noopener" target="_blank" class="text-accent-fg underline">{s.title}</a>
            <span> — data da página da RedotPay: {s.pageDate}</span>
          </li>
        );
      }
      if (lang === 'es') {
        const s = sourceEs(id);
        return (
          <li>
            <a href={s.url} rel="noopener" target="_blank" class="text-accent-fg underline">{s.title}</a>
            <span> — fecha de la página de RedotPay: {s.pageDate}</span>
          </li>
        );
      }
      if (lang === 'fr') {
        const s = sourceFr(id);
        return (
          <li>
            <a href={s.url} rel="noopener" target="_blank" class="text-accent-fg underline">{s.title}</a>
            <span> — date de la page RedotPay : {s.pageDate}</span>
          </li>
        );
      }
      if (lang === 'en') {
        const s = sourceEn(id);
        return (
          <li>
            <a href={s.url} rel="noopener" target="_blank" class="text-accent-fg underline">{s.title}</a>
            <span> — RedotPay page date: {s.pageDate}</span>
          </li>
        );
      }
      const s = SOURCES[id];
      return (
        <li>
          <a href={s.url} rel="noopener" target="_blank" class="text-accent-fg underline">{s.title}</a>
          <span> — آخر تحديث في المصدر: <bdi dir="rtl">{s.pageDate}</bdi></span>
        </li>
      );
    })}
  </ul>
</div>
