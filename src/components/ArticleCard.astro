---
import Cover from './Cover.astro';
import { articleUrl, categoryLabel, readingMinutes, readingLabel, formatDate, type Article } from '../lib/articles';
import { articleUrl as enUrl, categoryLabel as enCategory, readingMinutes as enMinutes, readingLabel as enReading, formatDate as enDate, type ArticleEn } from '../lib/en-articles';
import { articleUrl as frUrl, categoryLabel as frCategory, readingMinutes as frMinutes, readingLabel as frReading, formatDate as frDate, type ArticleFr } from '../lib/fr-articles';
import { articleUrl as esUrl, categoryLabel as esCategory, readingMinutes as esMinutes, readingLabel as esReading, formatDate as esDate, type ArticleEs } from '../lib/es-articles';
import { articleUrl as ptUrl, categoryLabel as ptCategory, readingMinutes as ptMinutes, readingLabel as ptReading, formatDate as ptDate, type ArticlePt } from '../lib/pt-articles';
import type { Lang } from '../i18n/lang';

interface Props { article: Article | ArticleEn | ArticleFr | ArticleEs | ArticlePt; lang?: Lang; }
const { article: a, lang = 'ar' } = Astro.props;
const href = lang === 'pt' ? ptUrl(a as ArticlePt) : lang === 'es' ? esUrl(a as ArticleEs) : lang === 'fr' ? frUrl(a as ArticleFr) : lang === 'en' ? enUrl(a as ArticleEn) : articleUrl(a as Article);
const cat = lang === 'pt' ? ptCategory(a.data.category) : lang === 'es' ? esCategory(a.data.category) : lang === 'fr' ? frCategory(a.data.category) : lang === 'en' ? enCategory(a.data.category) : categoryLabel(a.data.category);
const reading = lang === 'pt'
  ? ptReading(ptMinutes(a.body ?? ''))
  : lang === 'es'
    ? esReading(esMinutes(a.body ?? ''))
    : lang === 'fr'
      ? frReading(frMinutes(a.body ?? ''))
      : lang === 'en'
        ? enReading(enMinutes(a.body ?? ''))
        : `${readingLabel(readingMinutes(a.body ?? ''))} قراءة`;
const when = a.data.updatedDate ?? a.data.pubDate;
const date = lang === 'pt' ? ptDate(when) : lang === 'es' ? esDate(when) : lang === 'fr' ? frDate(when) : lang === 'en' ? enDate(when) : formatDate(when);
---
<article class="card group reveal flex flex-col overflow-hidden transition hover:-translate-y-1 hover:border-accent/60">
  <a href={href} class="flex h-full flex-col" aria-label={a.data.h1 ?? a.data.title}>
    <Cover icon={a.data.cover.icon} hue={a.data.cover.hue} class="aspect-[1.9]" />
    <div class="flex flex-1 flex-col p-5">
      <div class="flex items-center gap-2 text-xs text-muted">
        <span class="rounded-full bg-surface-2 px-2 py-0.5 font-semibold text-accent-fg">{cat}</span>
        <span>{reading}</span>
      </div>
      <h3 class="mt-3 text-lg font-bold leading-snug group-hover:text-accent-fg">{a.data.h1 ?? a.data.title}</h3>
      <p class="mt-2 line-clamp-2 text-sm text-muted">{a.data.description}</p>
      <p class="mt-auto pt-4 text-xs text-muted"><time datetime={when.toISOString()}>{date}</time></p>
    </div>
  </a>
</article>
