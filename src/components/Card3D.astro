---
/** رسم توضيحي لبطاقة دفع، بلا شعار شبكة وبلا اسم PayCards كجهة إصدار. */
---
<figure class="mx-auto w-full max-w-[400px]">
  <div class="card3d-host relative [perspective:1100px]" aria-hidden="true">
    <div class="card3d-glow absolute inset-6 rounded-[28px] bg-accent/40 blur-3xl"></div>
    <div class="card3d-float">
      <div data-tilt class="card3d relative aspect-[1.586] w-full rounded-[22px] p-[6%] text-white">
        <div class="card3d-shine absolute inset-0 rounded-[22px]"></div>
        <svg class="absolute inset-0 h-full w-full rounded-[22px]" viewBox="0 0 400 252" preserveAspectRatio="none">
          <defs>
            <linearGradient id="c3-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#123044" />
              <stop offset=".5" stop-color="#0c1c33" />
              <stop offset="1" stop-color="#10261f" />
            </linearGradient>
            <linearGradient id="c3-sheen" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#2ee6a8" stop-opacity=".28" />
              <stop offset="1" stop-color="#2ee6a8" stop-opacity="0" />
            </linearGradient>
          </defs>
          <rect width="400" height="252" rx="22" fill="url(#c3-bg)" />
          <path d="M0 168c70-40 120-20 180 8s90 36 220-20v96H0z" fill="#2ee6a8" fill-opacity=".08" />
          <path d="M0 40h400" stroke="url(#c3-sheen)" stroke-width="28" />
          <g fill="none" stroke="#ffffff" stroke-opacity=".08" stroke-width="1">
            <path d="M-10 80h180M40 20v90M220 200h200M300 150v110" />
          </g>
        </svg>
        <div class="relative flex h-full flex-col justify-between" dir="ltr">
          <div class="flex items-start justify-end">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-opacity=".8" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <path d="M8.5 16.5a5 5 0 0 0 0-9" />
              <path d="M5.2 19a8.5 8.5 0 0 0 0-14" />
              <path d="M12 21.2a12 12 0 0 0 0-18.4" />
            </svg>
          </div>
          <svg width="48" height="36" viewBox="0 0 48 36" aria-hidden="true">
            <rect x="1" y="1" width="46" height="34" rx="6" fill="#e6d7a2" />
            <path d="M1 12h46M14 1v34M1 24h46" stroke="#b89b55" stroke-width="1.2" />
          </svg>
          <div>
            <p class="font-mono text-[clamp(13px,4vw,18px)] tracking-[0.22em] opacity-80">•••• •••• •••• ••••</p>
            <p class="mt-2 text-[11px] font-semibold tracking-[0.14em] opacity-70">CARD HOLDER</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="mt-3 text-center text-xs text-muted">رسم توضيحي لبطاقة دفع، وليس شكل بطاقة RedotPay ولا شعار شبكة دفع.</figcaption>
</figure>

<style>
  .card3d {
    transform: rotateX(var(--rx, 8deg)) rotateY(var(--ry, -14deg));
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out;
    box-shadow:
      0 30px 60px -20px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(255 255 255 / 0.08) inset;
  }
  .card3d-shine {
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.16) var(--gx, 45%), transparent 62%);
    mix-blend-mode: screen;
  }
  .card3d-float { animation: float 6s ease-in-out infinite; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
</style>
