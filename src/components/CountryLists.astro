---
import { DELIVERY_COUNTRIES, DELIVERY_ONLY_COUNTRIES, SOURCES, UNSUPPORTED_COUNTRIES, REVIEWED_LABEL } from '../data/redotpay';
import { REVIEWED_LABEL_EN, sourceEn } from '../data/fees-en';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const reviewed = lang === 'en' ? REVIEWED_LABEL_EN : REVIEWED_LABEL;
const unsupported = lang === 'en' ? sourceEn('unsupported') : SOURCES.unsupported;
const delivery = lang === 'en' ? sourceEn('delivery') : SOURCES.delivery;
---
<div class="not-prose space-y-8">
  <p class="text-sm text-muted">
    {lang === 'en' ? <>Both lists checked on <time datetime="2026-10-24">{reviewed}</time>.</> : <>رُوجعت القائمتان في <time datetime="2026-10-24">{reviewed}</time>.</>}
  </p>

  <section>
    <h2 id="registration-block" class="text-2xl font-extrabold">{lang === 'en' ? 'Citizenships that cannot finish verification' : 'دول لا يكتمل فيها التوثيق'}</h2>
    <p class="mt-2 leading-8 text-muted">
      {lang === 'en' ? (
        <>RedotPay’s page says that if you are a <strong class="text-fg">citizen</strong> of one of these countries or regions, you cannot complete identity verification or use the service. The list follows local rules and sanctions policy, and RedotPay says it can change. The United States is on this list.{' '}<a href={unsupported.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(page update: {unsupported.pageDate}).</>
      ) : (
        <>نص الصفحة الرسمية: إذا كنت <strong class="text-fg">مواطناً</strong> لإحدى هذه الدول أو المناطق فلن تتمكن من إكمال التحقق من الهوية أو استخدام الخدمة. القائمة مبنية على تنظيم محلي وسياسات عقوبات، وRedotPay تقول إنها قد تتغير.{' '}<a href={SOURCES.unsupported.url} rel="noopener" target="_blank" class="text-accent-fg underline">المصدر</a>{' '}(تحديث الصفحة: {SOURCES.unsupported.pageDate}).</>
      )}
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {UNSUPPORTED_COUNTRIES.map(([ar, en]) => (
        <li class="rounded-xl border border-line bg-surface px-3 py-2 text-sm">
          {lang === 'en' ? en : <>{ar} <span class="text-muted" dir="ltr">({en})</span></>}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 id="no-physical-shipping" class="text-2xl font-extrabold">{lang === 'en' ? 'Places that do not receive the physical card' : 'دول لا تُشحن إليها البطاقة المادية'}</h2>
    <p class="mt-2 leading-8 text-muted">
      {lang === 'en' ? (
        <>This is the delivery list as published. It is wider than the signup block. Names that are not on the citizenship block above, but still do not receive a physical card:{' '}{DELIVERY_ONLY_COUNTRIES.map(([, en]) => en).join(', ')}.{' '}<a href={delivery.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(page update: {delivery.pageDate}).</>
      ) : (
        <>هذه قائمة التوصيل كما نُشرت، وهي أوسع من قائمة منع التسجيل. من الأسماء التي تهم كثيراً من القرّاء وليست في قائمة المنع أعلاه، لكن البطاقة المادية لا تُشحن إليها:{' '}{DELIVERY_ONLY_COUNTRIES.map(([ar]) => ar).join('، ')}.{' '}<a href={SOURCES.delivery.url} rel="noopener" target="_blank" class="text-accent-fg underline">المصدر</a>{' '}(تحديث الصفحة: {SOURCES.delivery.pageDate}).</>
      )}
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {DELIVERY_COUNTRIES.map(([ar, en]) => (
        <li class="rounded-xl border border-line bg-surface px-3 py-2 text-sm">
          {lang === 'en' ? en : <>{ar} <span class="text-muted" dir="ltr">({en})</span></>}
        </li>
      ))}
    </ul>
  </section>
</div>
