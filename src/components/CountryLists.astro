---
import { CARD_ISSUANCE_COUNTRIES, DELIVERY_COUNTRIES, DELIVERY_ONLY_COUNTRIES, LOCATION_COUNTRIES, SOURCES, UNSUPPORTED_COUNTRIES, countryPair } from '../data/redotpay';
import { sourceEn } from '../data/fees-en';
import { sourceFr } from '../data/fees-fr';
import { sourceEs } from '../data/fees-es';
import { sourcePt } from '../data/fees-pt';
import { countryFr } from '../data/countries-fr';
import { countryEs } from '../data/countries-es';
import { countryPt } from '../data/countries-pt';
import type { Lang } from '../i18n/lang';

interface Props { lang?: Lang; }
const { lang = 'ar' } = Astro.props;
const reviewed = lang === 'pt' ? '24 de outubro de 2026' : lang === 'es' ? '24 de octubre de 2026' : lang === 'fr' ? '24 octobre 2026' : lang === 'en' ? '24 October 2026' : '24 أكتوبر 2026';
const unsupported = lang === 'pt' ? sourcePt('unsupported') : lang === 'es' ? sourceEs('unsupported') : lang === 'fr' ? sourceFr('unsupported') : lang === 'en' ? sourceEn('unsupported') : SOURCES.unsupported;
const location = lang === 'pt' ? sourcePt('location') : lang === 'es' ? sourceEs('location') : lang === 'fr' ? sourceFr('location') : lang === 'en' ? sourceEn('location') : SOURCES.location;
const issuance = lang === 'pt' ? sourcePt('issuanceBlock') : lang === 'es' ? sourceEs('issuanceBlock') : lang === 'fr' ? sourceFr('issuanceBlock') : lang === 'en' ? sourceEn('issuanceBlock') : SOURCES.issuanceBlock;
const delivery = lang === 'pt' ? sourcePt('delivery') : lang === 'es' ? sourceEs('delivery') : lang === 'fr' ? sourceFr('delivery') : lang === 'en' ? sourceEn('delivery') : SOURCES.delivery;
const deliveryOnly = lang === 'pt'
  ? DELIVERY_ONLY_COUNTRIES.map(([, en]) => countryPt(en)).join(', ')
  : lang === 'es'
  ? DELIVERY_ONLY_COUNTRIES.map(([, en]) => countryEs(en)).join(', ')
  : lang === 'fr'
    ? DELIVERY_ONLY_COUNTRIES.map(([, en]) => countryFr(en)).join(', ')
    : lang === 'en'
      ? DELIVERY_ONLY_COUNTRIES.map(([, en]) => en).join(', ')
      : DELIVERY_ONLY_COUNTRIES.map(([ar]) => ar).join('، ');
---
<div class="not-prose space-y-8">
  <p class="text-sm text-muted">
    {lang === 'pt' ? <>Estas listas foram conferidas em <time datetime="2026-10-24">{reviewed}</time>.</> : lang === 'es' ? <>Estas listas se revisaron el <time datetime="2026-10-24">{reviewed}</time>.</> : lang === 'fr' ? <>Ces listes ont été vérifiées le <time datetime="2026-10-24">{reviewed}</time>.</> : lang === 'en' ? <>These lists were checked on <time datetime="2026-10-24">{reviewed}</time>.</> : <>رُوجعت هذه القوائم في <time datetime="2026-10-24">{reviewed}</time>.</>}
  </p>

  <section>
    <h2 id="registration-block" class="text-2xl font-extrabold">{lang === 'pt' ? 'Nacionalidades que não concluem a verificação' : lang === 'es' ? 'Nacionalidades que no terminan la verificación' : lang === 'fr' ? 'Nationalités qui ne finissent pas la vérification' : lang === 'en' ? 'Citizenships that cannot finish verification' : 'دول لا يكتمل فيها التوثيق'}</h2>
    <p class="mt-2 leading-8 text-muted">
      {lang === 'pt' ? (
        <>Se você é <strong class="text-fg">cidadão</strong> de um lugar da lista, não consegue concluir a verificação de identidade nem usar o serviço. A RedotPay diz que a lista segue regras locais e a política de sanções, e que pode mudar. Os Estados Unidos estão nela.{' '}<a href={unsupported.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fonte</a>{' '}(atualização da página: {unsupported.pageDate}).</>
      ) : lang === 'es' ? (
        <>Si eres <strong class="text-fg">ciudadano</strong> de un lugar de la lista, no puedes terminar la verificación de identidad ni usar el servicio. RedotPay dice que la lista sigue las normas locales y la política de sanciones, y que puede cambiar. Estados Unidos está en ella.{' '}<a href={unsupported.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fuente</a>{' '}(actualización de la página: {unsupported.pageDate}).</>
      ) : lang === 'fr' ? (
        <>Si vous êtes <strong class="text-fg">citoyen</strong> d’un lieu listé, vous ne pouvez pas terminer la vérification d’identité ni utiliser le service. RedotPay dit que la liste suit les règles locales et la politique de sanctions, et qu’elle peut changer. Les États-Unis y figurent.{' '}<a href={unsupported.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(mise à jour de la page : {unsupported.pageDate}).</>
      ) : lang === 'en' ? (
        <>If you are a <strong class="text-fg">citizen</strong> of a listed place, you cannot complete identity verification or use the service. RedotPay says the list follows local rules and sanctions policy and can change. The United States is on it.{' '}<a href={unsupported.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(page update: {unsupported.pageDate}).</>
      ) : (
        <>نص الصفحة الرسمية: إذا كنت <strong class="text-fg">مواطناً</strong> لإحدى هذه الدول أو المناطق فلن تتمكن من إكمال التحقق من الهوية أو استخدام الخدمة. القائمة مبنية على تنظيم محلي وسياسات عقوبات، وRedotPay تقول إنها قد تتغير.{' '}<a href={SOURCES.unsupported.url} rel="noopener" target="_blank" class="text-accent-fg underline">المصدر</a>{' '}(تحديث الصفحة: {SOURCES.unsupported.pageDate}).</>
      )}
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {UNSUPPORTED_COUNTRIES.map(([ar, en]) => (
        <li class="rounded-xl border border-line bg-surface px-3 py-2 text-sm">
          {lang === 'en' ? en : lang === 'pt' ? <>{countryPt(en)} <span class="text-muted" dir="ltr">({en})</span></> : lang === 'es' ? <>{countryEs(en)} <span class="text-muted" dir="ltr">({en})</span></> : lang === 'fr' ? <>{countryFr(en)} <span class="text-muted" dir="ltr">({en})</span></> : <>{ar} <span class="text-muted" dir="ltr">({en})</span></>}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 id="app-location" class="text-2xl font-extrabold">{lang === 'pt' ? 'Onde o aplicativo não abre' : lang === 'es' ? 'Dónde no se abre la aplicación' : lang === 'fr' ? 'Là où l’application ne s’ouvre pas' : lang === 'en' ? 'Where the app does not open' : 'أماكن لا يُفتح فيها التطبيق'}</h2>
    <p class="mt-2 leading-8 text-muted">
      {lang === 'pt' ? (
        <>Se você está em um desses lugares, a RedotPay diz que não dá para acessar o aplicativo. Os Estados Unidos estão na lista. A Tanzânia está nela e não está na lista de nacionalidades acima.{' '}<a href={location.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fonte</a>{' '}(atualização da página: {location.pageDate}).</>
      ) : lang === 'es' ? (
        <>Si te encuentras en uno de estos lugares, RedotPay dice que no puedes acceder a la aplicación. Estados Unidos está en la lista. Tanzania está en ella y no está en la lista de nacionalidades de arriba.{' '}<a href={location.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fuente</a>{' '}(actualización de la página: {location.pageDate}).</>
      ) : lang === 'fr' ? (
        <>Si vous vous trouvez dans l’un de ces lieux, RedotPay dit que vous ne pouvez pas accéder à l’application. Les États-Unis y figurent. La Tanzanie y figure et n’est pas sur la liste des nationalités ci-dessus.{' '}<a href={location.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(mise à jour de la page : {location.pageDate}).</>
      ) : lang === 'en' ? (
        <>If you are <strong class="text-fg">located</strong> in one of these places, RedotPay says you cannot access the app. The United States is on this list. Tanzania is on this list and is not on the citizenship list above.{' '}<a href={location.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(page update: {location.pageDate}).</>
      ) : (
        <>إذا كنت <strong class="text-fg">موجوداً</strong> في إحدى هذه المناطق فلن تتمكن من فتح التطبيق. الولايات المتحدة في هذه القائمة. تنزانيا هنا وليست في قائمة الجنسية أعلاه.{' '}<a href={SOURCES.location.url} rel="noopener" target="_blank" class="text-accent-fg underline">المصدر</a>{' '}(تحديث الصفحة: {SOURCES.location.pageDate}).</>
      )}
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {LOCATION_COUNTRIES.map((en) => {
        const [ar, name] = countryPair(en);
        return (
          <li class="rounded-xl border border-line bg-surface px-3 py-2 text-sm">
            {lang === 'en' ? name : lang === 'pt' ? <>{countryPt(name)} <span class="text-muted" dir="ltr">({name})</span></> : lang === 'es' ? <>{countryEs(name)} <span class="text-muted" dir="ltr">({name})</span></> : lang === 'fr' ? <>{countryFr(name)} <span class="text-muted" dir="ltr">({name})</span></> : <>{ar} <span class="text-muted" dir="ltr">({name})</span></>}
          </li>
        );
      })}
    </ul>
  </section>

  <section>
    <h2 id="card-issuance" class="text-2xl font-extrabold">{lang === 'pt' ? 'Residentes que não podem receber um cartão' : lang === 'es' ? 'Residentes que no pueden recibir una tarjeta' : lang === 'fr' ? 'Résidents qui ne peuvent pas recevoir de carte' : lang === 'en' ? 'Residents who cannot be issued a card' : 'مقيمون لا تُصدر لهم بطاقة'}</h2>
    <p class="mt-2 leading-8 text-muted">
      {lang === 'pt' ? (
        <>Residentes dessas áreas não podem receber cartão virtual nem físico, e o lugar não pode servir de endereço de cobrança. Os Estados Unidos estão na lista, assim como Índia, Indonésia, Marrocos, Nepal, Singapura e Turquia.{' '}<a href={issuance.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fonte</a>{' '}(atualização da página: {issuance.pageDate}).</>
      ) : lang === 'es' ? (
        <>Los residentes de estas zonas no pueden recibir ni tarjeta virtual ni tarjeta física, y el lugar no puede servir de dirección de facturación. Estados Unidos está en la lista, igual que India, Indonesia, Marruecos, Nepal, Singapur y Turquía.{' '}<a href={issuance.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fuente</a>{' '}(actualización de la página: {issuance.pageDate}).</>
      ) : lang === 'fr' ? (
        <>Les résidents de ces zones ne peuvent recevoir ni carte virtuelle ni carte physique, et le lieu ne peut pas servir d’adresse de facturation. Les États-Unis y figurent, ainsi que l’Inde, l’Indonésie, le Maroc, le Népal, Singapour et la Turquie.{' '}<a href={issuance.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(mise à jour de la page : {issuance.pageDate}).</>
      ) : lang === 'en' ? (
        <>Residents of these areas are ineligible for a virtual card and a physical card, and the location cannot be a billing address. The United States is on this list. So are India, Indonesia, Morocco, Nepal, Singapore, and Turkey.{' '}<a href={issuance.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(page update: {issuance.pageDate}).</>
      ) : (
        <>المقيمون في هذه المناطق لا تُصدر لهم بطاقة افتراضية ولا مادية، ولا يُقبل المكان عنوان فوترة. الولايات المتحدة في القائمة، ومعها الهند وإندونيسيا والمغرب ونيبال وسنغافورة وتركيا.{' '}<a href={SOURCES.issuanceBlock.url} rel="noopener" target="_blank" class="text-accent-fg underline">المصدر</a>{' '}(تحديث الصفحة: {SOURCES.issuanceBlock.pageDate}).</>
      )}
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {CARD_ISSUANCE_COUNTRIES.map((en) => {
        const [ar, name] = countryPair(en);
        return (
          <li class="rounded-xl border border-line bg-surface px-3 py-2 text-sm">
            {lang === 'en' ? name : lang === 'pt' ? <>{countryPt(name)} <span class="text-muted" dir="ltr">({name})</span></> : lang === 'es' ? <>{countryEs(name)} <span class="text-muted" dir="ltr">({name})</span></> : lang === 'fr' ? <>{countryFr(name)} <span class="text-muted" dir="ltr">({name})</span></> : <>{ar} <span class="text-muted" dir="ltr">({name})</span></>}
          </li>
        );
      })}
    </ul>
  </section>

  <section>
    <h2 id="no-physical-shipping" class="text-2xl font-extrabold">{lang === 'pt' ? 'Lugares que não recebem o cartão físico' : lang === 'es' ? 'Lugares que no reciben la tarjeta física' : lang === 'fr' ? 'Lieux qui ne reçoivent pas la carte physique' : lang === 'en' ? 'Places that do not receive the physical card' : 'دول لا تُشحن إليها البطاقة المادية'}</h2>
    <p class="mt-2 leading-8 text-muted">
      {lang === 'pt' ? (
        <>Esta é a lista de envio como foi publicada. Ela é mais ampla que o bloqueio de cadastro. Nomes que não estão no bloqueio de nacionalidade acima, mas que não recebem o cartão físico: {deliveryOnly}.{' '}<a href={delivery.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fonte</a>{' '}(atualização da página: {delivery.pageDate}).</>
      ) : lang === 'es' ? (
        <>Esta es la lista de envío tal como se publicó. Es más amplia que el bloqueo de registro. Nombres que no están en el bloqueo de nacionalidad de arriba, pero que no reciben la tarjeta física: {deliveryOnly}.{' '}<a href={delivery.url} rel="noopener" target="_blank" class="text-accent-fg underline">Fuente</a>{' '}(actualización de la página: {delivery.pageDate}).</>
      ) : lang === 'fr' ? (
        <>Ceci est la liste de livraison telle que publiée. Elle est plus large que le blocage d’inscription. Noms absents du blocage de nationalité ci-dessus, mais qui ne reçoivent pas la carte physique : {deliveryOnly}.{' '}<a href={delivery.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(mise à jour de la page : {delivery.pageDate}).</>
      ) : lang === 'en' ? (
        <>This is the delivery list as published. It is wider than the signup block. Names that are not on the citizenship block above, but still do not receive a physical card:{' '}{deliveryOnly}.{' '}<a href={delivery.url} rel="noopener" target="_blank" class="text-accent-fg underline">Source</a>{' '}(page update: {delivery.pageDate}).</>
      ) : (
        <>هذه قائمة التوصيل كما نُشرت، وهي أوسع من قائمة منع التسجيل. من الأسماء التي تهم كثيراً من القرّاء وليست في قائمة المنع أعلاه، لكن البطاقة المادية لا تُشحن إليها:{' '}{deliveryOnly}.{' '}<a href={SOURCES.delivery.url} rel="noopener" target="_blank" class="text-accent-fg underline">المصدر</a>{' '}(تحديث الصفحة: {SOURCES.delivery.pageDate}).</>
      )}
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {DELIVERY_COUNTRIES.map(([ar, en]) => (
        <li class="rounded-xl border border-line bg-surface px-3 py-2 text-sm">
          {lang === 'en' ? en : lang === 'pt' ? <>{countryPt(en)} <span class="text-muted" dir="ltr">({en})</span></> : lang === 'es' ? <>{countryEs(en)} <span class="text-muted" dir="ltr">({en})</span></> : lang === 'fr' ? <>{countryFr(en)} <span class="text-muted" dir="ltr">({en})</span></> : <>{ar} <span class="text-muted" dir="ltr">({en})</span></>}
        </li>
      ))}
    </ul>
  </section>
</div>
