---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cover from '../../components/Cover.astro';
import CTABox from '../../components/CTABox.astro';
import CTAButton from '../../components/CTAButton.astro';
import V from '../../components/V.astro';
import VText from '../../components/VText.astro';
import FAQ from '../../components/FAQ.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {
  getArticles,
  readingMinutes,
  readingLabel,
  formatDate,
  categoryLabel,
  relatedArticles,
  articleSchema,
  breadcrumbSchema,
  faqSchema,
  articleUrl,
  type Article,
} from '../../lib/articles';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((article) => ({ params: { slug: article.id }, props: { article, all } }));
}

interface Props { article: Article; all: Article[]; }
const { article, all } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);

const minutes = readingMinutes(article.body);
const updated = data.updatedDate ?? data.pubDate;
const related = await relatedArticles(article, all);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
if (data.faq.length) toc.push({ depth: 2, slug: 'faq', text: 'أسئلة شائعة' });

const crumbs = [
  { name: 'الرئيسية', url: '/' },
  { name: 'المقالات', url: '/articles' },
  { name: categoryLabel(data.category), url: `/articles/category/${data.category}` },
  { name: data.h1 ?? data.title, url: articleUrl(article) },
];
const schema = [articleSchema(article), breadcrumbSchema(crumbs)];
if (data.faq.length) schema.push(faqSchema(data.faq));
---
<BaseLayout
  title={data.title}
  description={data.description}
  page={`article:${article.id}`}
  type="article"
  schema={schema}
  published={data.pubDate}
  modified={updated}
>
  <article class="container-x pt-6 sm:pt-10">
<div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_16rem]">
      <div class="min-w-0 mx-auto w-full max-w-3xl">
    <header>
          <Breadcrumbs items={crumbs} />
          <a href={`/articles/category/${data.category}`} class="eyebrow mt-6">{categoryLabel(data.category)}</a>
          <h1 class="mt-4 text-3xl font-extrabold leading-[1.35] sm:text-[2.6rem]">{data.h1 ?? data.title}</h1>
          <p class="mt-4 text-lg text-muted">{data.description}</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
            <span>نُشر: <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time></span>
            {data.updatedDate && <span>آخر تحديث: <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
            <span>{readingLabel(minutes)} قراءة</span>
          </div>
        </header>

        <Cover icon={data.cover.icon} hue={data.cover.hue} size="lg" label={data.h1 ?? data.title} class="mt-8 aspect-[2.4] rounded-3xl border border-line" />

        
        <div class="mt-10"></div>
        <!-- صندوق الملخص السريع -->
        <section aria-label="الإجابة المختصرة" class="rounded-2xl border border-accent/40 bg-surface p-5 sm:p-6">
          <p class="flex items-center gap-2 text-sm font-bold text-accent-fg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
            الإجابة المختصرة
          </p>
          <VText as="p" text={data.summary} class="mt-2 leading-8" />
          <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
            <CTAButton position="summary" label="احصل على بطاقتك" />
          </div>
        </section>

        <!-- جدول المحتويات (جوال) -->
        {toc.length > 2 && (
          <details class="mt-6 rounded-2xl border border-line bg-surface lg:hidden">
            <summary class="flex cursor-pointer items-center justify-between px-5 py-4 font-bold">محتويات المقال <span class="faq-icon text-accent-fg transition-transform">+</span></summary>
            <ol class="space-y-2 px-5 pb-5 text-sm">
              {toc.map((h) => <li class={h.depth === 3 ? 'ps-4 text-muted' : ''}><a href={`#${h.slug}`} class="hover:text-accent-fg">{h.text}</a></li>)}
            </ol>
          </details>
        )}

        <div class="prose prose-pc prose-lg mt-8 max-w-none prose-headings:font-extrabold prose-h2:mt-12 prose-h2:text-2xl prose-h3:text-xl prose-p:leading-[1.95] prose-li:leading-[1.9]">
          <Content components={{ CTABox, V, CTAButton }} />

          {data.faq.length > 0 && (
            <>
              <h2 id="faq">أسئلة شائعة</h2>
              <FAQ items={data.faq} />
            </>
          )}
        </div>

        <CTABox position="end" />

        <p class="rounded-xl border border-line bg-surface-2 p-4 text-sm leading-7 text-muted">
          <strong class="text-fg">تنبيه:</strong> PayCards موقع مستقل وغير تابع لـ RedotPay. الرسوم والحدود والدول المدعومة تتغيّر، فراجعها في التطبيق الرسمي قبل أي قرار. العملات الرقمية تنطوي على مخاطر، وهذا المحتوى تعليمي وليس نصيحة مالية. الروابط في هذه الصفحة <a href="/disclosure" class="underline">روابط إحالة</a>.
        </p>
      </div>

      <!-- جدول المحتويات (سطح المكتب) -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-5">
          {toc.length > 2 && (
            <nav aria-label="محتويات المقال" class="rounded-2xl border border-line bg-surface p-5">
              <p class="font-bold">محتويات المقال</p>
              <ol class="mt-3 space-y-2 text-sm text-muted">
                {toc.map((h) => <li class={h.depth === 3 ? 'ps-3 text-[13px]' : ''}><a href={`#${h.slug}`} class="hover:text-accent-fg">{h.text}</a></li>)}
              </ol>
            </nav>
          )}
          <div class="rounded-2xl border border-line bg-surface p-5 text-center">
            <p class="text-sm font-bold">ابدأ مع RedotPay</p>
            <p class="mt-1 text-xs leading-6 text-muted">بطاقة افتراضية تُشحن بالعملات الرقمية وتدعم الدفع بالهاتف.</p>
            <CTAButton position="sidebar" label="احصل على بطاقتك" size="sm" full class="mt-3" />
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="container-x">
        <h2 id="related-title" class="section-title">مقالات ذات صلة</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
