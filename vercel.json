{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/go/redotpay", "destination": "https://wap.redotpay.com/ar/invite/?referralId=yj8cq", "permanent": false },
    { "source": "/go/redotpay-en", "destination": "https://wap.redotpay.com/en/invite/?referralId=yj8cq", "permanent": false },
    { "source": "/go/redotpay-fr", "destination": "https://wap.redotpay.com/fr/invite/?referralId=yj8cq", "permanent": false },
    { "source": "/go/redotpay-es", "destination": "https://wap.redotpay.com/es/invite/?referralId=yj8cq", "permanent": false },
    { "source": "/go/redotpay-pt", "destination": "https://wap.redotpay.com/pt/invite/?referralId=yj8cq", "permanent": false },
    {
      "source": "/:path+/",
      "has": [{ "type": "host", "value": "paycards.io" }],
      "destination": "https://www.paycards.io/:path*",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "paycards.io" }],
      "destination": "https://www.paycards.io/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/go/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
