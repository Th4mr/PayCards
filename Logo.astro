---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<a href="/" class:list={['inline-flex items-center gap-2 font-extrabold', cls]} aria-label="PayCards — الرئيسية" dir="ltr">
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id="lg-logo" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2ee6a8" />
        <stop offset="1" stop-color="#4c6ef5" />
      </linearGradient>
    </defs>
    <rect x="2" y="7" width="20" height="14" rx="3.2" fill="#4c6ef5" opacity=".55" transform="rotate(-12 12 14)" />
    <rect x="6" y="11" width="22" height="15" rx="3.4" fill="url(#lg-logo)" />
    <rect x="9" y="15.5" width="5" height="4" rx="1" fill="#0b1324" opacity=".75" />
    <path d="M6 22.5h22" stroke="#0b1324" stroke-opacity=".25" stroke-width="1.2" />
  </svg>
  <span class="text-lg tracking-tight">Pay<span class="text-accent-fg">Cards</span></span>
</a>
